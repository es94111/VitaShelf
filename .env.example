# ─── Backend ──────────────────────────────────────────────────────────────────
# SQLite file path. Use a volume-mounted path in production to persist data.
DATABASE_URL=file:./data/vitashelf.db
JWT_SECRET=change-me-to-a-long-random-secret
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://your-domain.com
UPLOAD_DIR=/app/uploads

# ─── Google SSO (optional) ───────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Database Encryption (optional) ──────────────────────────────────────────
# DB_ENCRYPTION_KEY=your-long-random-encryption-key

# ─── Docker Compose Production ────────────────────────────────────────────────
GITHUB_REPOSITORY=your-github-username/VitaShelf
IMAGE_TAG=latest
