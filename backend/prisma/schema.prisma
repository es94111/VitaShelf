generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─── User ──────────────────────────────────────────────────────────────────────

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  displayName       String
  role              String   @default("USER")
  theme             String   @default("light")
  authProvider      String   @default("LOCAL")
  googleId          String?  @unique
  isActive          Boolean  @default(true)
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  products  Product[]
  tags      Tag[]
  loginLogs LoginLog[]
}

// Role:         "ADMIN" | "USER" | "VIEWER"
// AuthProvider: "LOCAL" | "GOOGLE"

// ─── AdminSettings ──────────────────────────────────────────────────────────────

model AdminSettings {
  id                 String  @id @default("singleton")
  registrationOpen   Boolean @default(true)
  registrationNotice String  @default("")
  // 完整備份匯入大小上限（MB）。0 = 不限制（仍受硬上限保護）。
  maxImportSizeMb    Int     @default(200)
}

// ─── LoginLog ───────────────────────────────────────────────────────────────────

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  ip        String
  country   String   @default("")
  method    String   @default("local")
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([email, createdAt])
  @@index([success, createdAt])
}

// ─── Tag ───────────────────────────────────────────────────────────────────────

model Tag {
  id     String @id @default(cuid())
  name   String
  color  String @default("#64748B")
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  products ProductTag[]

  @@unique([name, userId])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

// ─── Product ───────────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String
  category    String
  subCategory String?
  spec        String?
  barcode     String?
  imageUrl    String?
  notes       String?
  isDeleted   Boolean  @default(false)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tags      ProductTag[]
  purchases PurchaseRecord[]
  stockLogs StockLog[]
}

// ProductCategory: "SKINCARE" | "SUPPLEMENT"

// ─── PurchaseRecord ────────────────────────────────────────────────────────────

model PurchaseRecord {
  id              String    @id @default(cuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseDate    DateTime
  quantity        Int
  unitPrice       Float?
  totalPrice      Float?
  channel         String?
  receiptUrl      String?
  manufactureDate DateTime?
  expiryDate      DateTime
  openedDate      DateTime?
  paoMonths       Int?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  stockLog        StockLog?
}

// ─── StockLog ──────────────────────────────────────────────────────────────────

model StockLog {
  id               String          @id @default(cuid())
  productId        String
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseRecordId String?         @unique
  purchaseRecord   PurchaseRecord? @relation(fields: [purchaseRecordId], references: [id], onDelete: SetNull)
  type             String
  quantity         Int
  reason           String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

// StockLogType: "IN" | "OUT_USE" | "OUT_DISCARD" | "ADJUST"
